    {
      "id": "reconstruction",
      "part": "ppt/slides/slide9.xml",
      "title": "预测与重构的计算依赖",
      "required_objects": [
        "reconstruction.title"
      ],
      "claims": [
        {
          "text": "先识别已知负荷与参考角，再读网络输出的独立变量。Sigmoid缩放因子通过边界映射形成实际预测量。AC潮流求解重构PQ电压、相角和其余发电量。等式重构不能自动处理所有运行不等式，Newton收敛情况仍需检查。参考角在原表与实现节有表述差异，具体实现复现时需要核对。",
          "source": "deepopf",
          "locator": "Table II、§IV-C–D、式(8)，PDF p.4",
          "status": "interpretation"
        }
      ],
      "images": [
        {
          "index": 0,
          "sha256": "e357ea39fa1338f504470e9f7dce368f70e7910c76241510e178cc250f4484cc",
          "asset": "figures/reconstruction.png",
          "purpose": "original scientific schematic, not measured results"
        }
      ]
    },
    {
      "id": "training",
      "part": "ppt/slides/slide10.xml",
      "title": "训练目标与零阶梯度估计",
      "required_objects": [
        "training.title"
      ],
      "claims": [
        {
          "text": "前向路径中，参考输出提供预测损失；经过AC潮流重构的越限形成惩罚。惩罚通过求解间接依赖网络输出，用正负两次扰动的差估计梯度。没有添加原文未用的潮流残差损失，也没有伪造训练曲线。",
          "source": "deepopf",
          "locator": "§IV-E–F，式(12)–(17)，PDF p.5",
          "status": "interpretation"
        }
      ]
    },
